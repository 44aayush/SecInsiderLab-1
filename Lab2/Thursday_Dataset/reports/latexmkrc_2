#!/usr/bin/env perl

@default_files = ("thesis");

# Use LuaLaTeX to create the PDF.
$pdflatex = 'lualatex -synctex=1 -interaction=nonstopmode';
$pdf_mode = 1;
$postscript_mode = $dvi_mode = 0;

# Use Biber for the bibliography.
$biber = 'biber %O --bblencoding=utf8 -u -U --output_safechars %B';
$biber_silent_switch = '--onlylog';

# Remove temporary build artifacts after latexmk finishes, while preserving
# the generated PDF. Use with: latexmk -r latexmkrc_2 thesis.tex
END {
    my $root = $root_filename || 'thesis';
    my @temporary_extensions = qw(
        aux bbl bcf blg fdb_latexmk fls lof log lol lot out
        run.xml synctex.gz toc idx ilg ind
    );

    unlink map { "$root.$_" } @temporary_extensions;
}
